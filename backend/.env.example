# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-buyzo-super-secret-key-demo-2026-ecommerce
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (mysql | sqlite)
# Set DB_ENGINE=mysql when running MySQL on 3306 or in Docker.
# If DB_ENGINE=sqlite or MySQL connection fails, it falls back to SQLite automatically.
DB_ENGINE=sqlite
DB_NAME=buyzo_db
DB_USER=root
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=3306

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email Backend (console prints to terminal for zero-cost demo)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@buyzo.com

# Payments Configuration (Mock gateway enabled by default)
ENABLE_MOCK_PAYMENT=True
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
